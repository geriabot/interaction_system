# Source dependencies of the interaction system: vcs import src < src/interaction_system/thirdparty.repos
repositories:
  # The behavioral control architecture (orchestrator + behavior runners). Only its base is
  # needed: its optional LLM orchestrators (its llm.repos) are not used here
  third_party/koch2:
    type: git
    url: https://github.com/geriabot/koch2.git
    version: b69a975718a893d8ab91d36cc92d49ea27610e0f  # koch2 main, the commit this version was tested with
  # The speech capability: speech-to-text and text-to-speech actions
  third_party/simple_hri:
    type: git
    url: https://github.com/rodperex/simple_hri.git
    version: a62279178708465ddff38e9005c36758c8cdd8fa  # simple_hri main, the commit this version was tested with
