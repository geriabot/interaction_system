# Source dependencies of the interaction system: vcs import src < src/interaction_system/thirdparty.repos
repositories:
  # The behavioral control architecture (orchestrator + behavior runners) and, on its devel
  # branch, the interpretation server this branch uses. Only its base is needed: its optional
  # LLM orchestrators (its llm.repos) are not used here
  third_party/behavior_architecture:
    type: git
    url: https://github.com/geriabot/behavior_architecture.git
    version: devel
  # The speech capability: speech-to-text and text-to-speech actions
  third_party/simple_hri:
    type: git
    url: https://github.com/rodperex/simple_hri.git
    version: main
