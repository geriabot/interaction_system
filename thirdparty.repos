# Source dependencies of the interaction system: vcs import src < src/interaction_system/thirdparty.repos
repositories:
  # The behavioral control architecture (orchestrator + behavior runners) and the interpretation
  # server this branch uses. Only its base is needed: its optional LLM orchestrators (its
  # llm.repos) are not used here
  third_party/koch2:
    type: git
    url: https://github.com/geriabot/koch2.git
    version: a0e632b084c768f11d1493a01fa6c215f44526f1  # koch2 main, the commit this version was tested with
  # The speech capability: speech-to-text and text-to-speech actions
  third_party/simple_hri:
    type: git
    url: https://github.com/rodperex/simple_hri.git
    version: main
  # The perception system: only its interfaces (perception_system_interfaces) are built here, for
  # the state of the user (get_user_state). The perception system itself (lip activity for
  # barge-in, the emotion) runs from its own workspace, with its own dependencies
  third_party/perception_system:
    type: git
    url: https://github.com/geriabot/perception_system.git
    version: 588d680b11b0d9090261c98a7253bee48d6a8405  # perception_system main, the commit this version was tested with
