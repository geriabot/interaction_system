<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>interaction_sim</name>
  <version>0.1.0</version>
  <description>Simulation of the interaction system: a simulated speech capability and simulated users (scripted or driven by an LLM) that run dialogues without audio, for the tests and the experiments.</description>
  <maintainer email="rodrigo.perez@urjc.es">Rodrigo Pérez-Rodríguez</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ros2_dialog_interfaces</depend>
  <depend>simple_hri_interfaces</depend>
  <depend>interaction_intelligence</depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>lifecycle_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
