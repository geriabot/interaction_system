<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by make_ablations.py (keywords_only_cancel) from the method's common.xml -->
<root BTCPP_format="4">
  <!-- Subtrees shared by every dialogue behavior. Each behavior (slot_filling.xml,
       explanation.xml, ...) begins the dialogue and then runs one user turn per cycle:
         turn limit -> listen -> (spoken cancellation | the strategy's turn) -> speak
       until the dialogue is done or aborted, and concludes with its outcome.
       Every ending has a closing line and an outcome with its reason: the strategy's own
       (completed, partial, failed), the user's (cancelled), or one decided here by
       EndDialogue (user_silent, breakdown, turn_limit) or by Conclude (error).
       The orchestrator writes in the blackboard, before the behavior starts: the request
       (goal, as JSON), dialogue_id, skip_intro, the limits (max_turns, wait_timeout,
       max_silent_waits, max_stalled, max_attempts, tts_timeout, intelligence_timeout,
       reply_budget, opening_budget, user_speaking_topic, filler_after_s, filler_repeat_s) and
       the counters at zero (turns, timeouts, stalled, attempts, help, spoken; done false,
       progress true; ending, outcome empty; reply_deadline 0). Each behavior wraps what
       prepares a reply (its opening, and the reply to a user turn) in WithFillers: a reply not
       ready in filler_after_s seconds is preceded by a fixed conversational filler, which is not
       a turn and changes no counter; and the wait for the model is bounded: the intelligence may
       spend reply_budget seconds (opening_budget for the opening) asking it for the reply, then
       answers with the skills' fallbacks (each AskIntelligence sends what is left of the budget,
       until reply_deadline). intelligence_timeout is the hard limit of every request. The
       state of the dialogue (dialogue, JSON) is filled by the interaction intelligence, which
       keeps none: every AskIntelligence sends it and gets it back updated, with the reply, the
       label, the phase and the data of the dialogue. -->

  <!-- The start of every dialogue: the state from the request, the closing line for a
       failure of the system, fetched now so that the robot can say it even if the
       intelligence fails later, and the conversational fillers (one per line), fetched now
       because they are said while the intelligence is busy -->
  <BehaviorTree ID="Begin">
    <Sequence>
      <AskIntelligence skill="begin" args="{goal}"/>
      <AskIntelligence skill="closing" option="error" reply="{error_closing}"/>
      <AskIntelligence skill="fillers" reply="{fillers}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Fails when the dialogue has used every turn allowed (max_turns, 0 = unlimited), after
       the robot says the closing line -->
  <BehaviorTree ID="TurnLimit">
    <Fallback>
      <ScriptCondition code="max_turns &lt;= 0 || turns &lt; max_turns"/>
      <Sequence>
        <SubTree ID="EndDialogue" _autoremap="true" reason="turn_limit"/>
        <Speak text="{reply}"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- Succeeds with what the user said (user_text), a new turn; fails if the user says
       nothing within wait_timeout -->
  <BehaviorTree ID="ListenToUser">
    <Sequence>
      <Listen text="{user_text}"/>
      <Script code="timeouts := 0; turns += 1; progress := true"/>
    </Sequence>
  </BehaviorTree>

  <!-- The user said nothing for wait_timeout seconds. Silence is not abandonment: the robot
       says it is waiting, repeats what it had asked, or stays quiet (the silence skill
       chooses, with fixed phrases); a step that takes time (wait) is not counted. After
       max_silent_waits waits in a row (max_silence seconds; 0 = never) the robot says the
       closing line and the dialogue ends (user_silent) -->
  <BehaviorTree ID="UserSilent">
    <Sequence>
      <AskIntelligence skill="silence" number="{timeouts}" option="{last_utterance}"/>
      <Fallback>
        <ScriptCondition code="label == 'wait'"/>
        <Sequence>
          <Script code="timeouts += 1"/>
          <IfThenElse>
            <ScriptCondition code="max_silent_waits &lt;= 0 || timeouts &lt; max_silent_waits"/>
            <Fallback>
              <ScriptCondition code="label == 'quiet'"/>
              <Speak text="{reply}"/>
            </Fallback>
            <Sequence>
              <SubTree ID="EndDialogue" _autoremap="true" reason="user_silent"/>
              <Speak text="{reply}"/>
            </Sequence>
          </IfThenElse>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- The spoken cancellation ("stop, forget it"), checked before the strategy handles the
       turn: the robot asks for confirmation, then ends the dialogue or resumes it with what
       it had asked (last_utterance). Asked whether they want to stop, a user who says instead
       that they have finished, in a strategy whose end the user decides, gets the strategy's
       own closing: a normal end (label finished). Fails when the user did not ask to stop, or
       answered the confirmation by going on with the task (label none), so that the strategy
       takes the turn -->
  <BehaviorTree ID="CancelCheck">
    <Sequence>
      <AskIntelligence skill="ablation.cancel_check_keywords_only" user_text="{user_text}" option="{last_utterance}"/>
      <ScriptCondition code="label != 'none'"/>
      <Script code="done := label == 'confirmed' || label == 'finished'"/>
    </Sequence>
  </BehaviorTree>

  <!-- A user turn without progress (not understood, asked to repeat): counts it, and fails
       when max_stalled turns in a row had no progress (0 = unlimited). The condition of an
       IfThenElse: then the strategy's recovery, else EndDialogue (breakdown) -->
  <BehaviorTree ID="NoProgress">
    <Sequence>
      <Script code="stalled += 1; progress := false"/>
      <ScriptCondition code="max_stalled &lt;= 0 || stalled &lt; max_stalled"/>
    </Sequence>
  </BehaviorTree>

  <!-- After the strategy handled a turn: a turn with progress resets the count of turns
       without progress -->
  <BehaviorTree ID="CountProgress">
    <Fallback>
      <ScriptCondition code="progress == false"/>
      <Script code="stalled := 0"/>
    </Fallback>
  </BehaviorTree>

  <!-- An ending decided by the tree (reason: user_silent, breakdown or turn_limit): the fixed
       closing line in reply (said by the caller), and the dialogue is done -->
  <BehaviorTree ID="EndDialogue">
    <Sequence>
      <AskIntelligence skill="closing" option="{reason}"/>
      <Script code="ending := reason; done := true"/>
    </Sequence>
  </BehaviorTree>

  <!-- The end of every dialogue. If it ended without a closing line (a failure of the system:
       the LLM, speech, the intelligence), the robot says the fixed one (error). Then the
       outcome: succeeds if completed; otherwise result_reason says why -->
  <BehaviorTree ID="Conclude">
    <Sequence>
      <ForceSuccess>
        <Fallback>
          <ScriptCondition code="done == true"/>
          <Sequence>
            <Script code="ending := 'error'"/>
            <Speak text="{error_closing}"/>
          </Sequence>
        </Fallback>
      </ForceSuccess>
      <AskIntelligence skill="result" option="{ending}" label="{outcome}" reply="{result_reason}"/>
      <ScriptCondition code="outcome == 'completed'"/>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="AskIntelligence" editable="true">
      <input_port name="skill" type="std::string">The skill to ask, e.g. slot_filling.update</input_port>
      <input_port name="user_text" default="" type="std::string">What the user said, if the skill needs it</input_port>
      <input_port name="option" default="" type="std::string">A word the skill needs (e.g. done, stuck)</input_port>
      <input_port name="number" default="0" type="int">A number the skill needs (e.g. the attempts so far)</input_port>
      <input_port name="args" default="" type="std::string">A JSON object the skill needs (begin: the goal)</input_port>
      <input_port name="dialogue_id" default="{dialogue_id}" type="std::string">The dialogue</input_port>
      <input_port name="timeout_s" default="{intelligence_timeout}" type="double">Longest wait for the answer (s)</input_port>
      <input_port name="deadline" default="{reply_deadline}" type="double">When the time budget of the reply being prepared ends (steady clock, s; 0: none)</input_port>
      <inout_port name="state" default="{dialogue}" type="std::string">The state of the dialogue</inout_port>
      <output_port name="reply" default="{reply}" type="std::string">What the robot must say</output_port>
      <output_port name="label" default="{label}" type="std::string">What the skill found</output_port>
      <output_port name="phase" default="{phase}" type="std::string">The phase of the dialogue</output_port>
      <output_port name="data" default="{data}" type="std::string">The data of the dialogue (JSON)</output_port>
      <output_port name="error" default="{failure_reason}" type="std::string">Why the skill failed</output_port>
    </Action>
    <Action ID="Listen" editable="true">
      <input_port name="timeout_s" default="{wait_timeout}" type="double">Longest wait for the user (s)</input_port>
      <output_port name="text" default="{user_text}" type="std::string">What the user said</output_port>
    </Action>
    <Action ID="Speak" editable="true">
      <input_port name="text" type="std::string">What to say</input_port>
      <input_port name="timeout_s" default="{tts_timeout}" type="double">Longest time to say it (s)</input_port>
      <input_port name="barge_in_topic" default="{user_speaking_topic}" type="std::string">Bool topic, True while the user speaks (empty: no barge-in)</input_port>
      <output_port name="last_utterance" default="{last_utterance}" type="std::string">The text said</output_port>
      <inout_port name="spoken" default="{spoken}" type="int">Utterances said in the dialogue</inout_port>
    </Action>
    <Decorator ID="WithFillers" editable="true">
      <input_port name="after_s" default="{filler_after_s}" type="double">Seconds without a reply before the first filler (&lt;= 0: no fillers)</input_port>
      <input_port name="repeat_s" default="{filler_repeat_s}" type="double">Seconds between the fillers after the ladder&apos;s steps (&lt;= 0: none after them)</input_port>
      <input_port name="phrases" default="{fillers}" type="std::string">The filler phrases, one per line</input_port>
      <input_port name="timeout_s" default="{tts_timeout}" type="double">Longest time to say a filler (s)</input_port>
      <inout_port name="last" default="{last_filler}" type="std::string">The last filler said</inout_port>
      <input_port name="budget_s" default="{reply_budget}" type="double">Time the intelligence may spend asking the model for this reply (s; &lt;= 0: no budget)</input_port>
      <output_port name="deadline" default="{reply_deadline}" type="double">When the budget of the reply ends (steady clock, s; 0 when no reply is being prepared)</output_port>
    </Decorator>
  </TreeNodesModel>
</root>
