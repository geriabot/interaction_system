<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Explanation">
  <include path="common.xml"/>

  <!-- Explain a topic (from the task and the resources) and verify that the user understood it
       with teach-back: the robot asks the user to say it back in their own words, and the reply
       is judged against the key points of the explanation. Each reply to a check is:
       verified (every critical point said back correctly: the robot closes, success), progress
       (some points said back right and none wrong: the robot confirms them and asks only for the
       critical points still missing, without counting a failed check), gaps (a critical point
       missing or wrong, without progress: the robot explains again only those points and asks
       again), a question (answered, then the check again), declines (only "I understood", or a
       refusal: the fallback, a direct question about the most critical point), not understood
       (the whole topic explained again in another way) or other (a turn without progress: the
       check again). After max_attempts failed checks the robot closes reminding the critical
       points (failed). The result is the status of each key point. -->
  <BehaviorTree ID="Explanation">
    <Sequence>
      <!-- The opening, with fillers while it is prepared (and its own time budget) -->
      <WithFillers budget_s="{opening_budget}">
        <SubTree ID="ExplanationOpening" _autoremap="true"/>
      </WithFillers>
      <Speak text="{reply}"/>
      <Fallback>
        <Repeat num_cycles="-1">
          <Sequence>
            <SubTree ID="TurnLimit" _autoremap="true"/>
            <IfThenElse>
              <SubTree ID="ListenToUser" _autoremap="true"/>
              <Sequence>
                <!-- The reply to the turn, with fillers while it is prepared -->
                <WithFillers>
                  <Fallback>
                    <SubTree ID="CancelCheck" _autoremap="true"/>
                    <SubTree ID="ExplanationTurn" _autoremap="true"/>
                  </Fallback>
                </WithFillers>
                <SubTree ID="CountProgress" _autoremap="true"/>
                <Speak text="{reply}"/>
              </Sequence>
              <SubTree ID="UserSilent" _autoremap="true"/>
            </IfThenElse>
            <ScriptCondition code="done == false"/>
          </Sequence>
        </Repeat>
        <SubTree ID="Conclude" _autoremap="true"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ExplanationOpening">
    <Sequence>
      <SubTree ID="Begin" _autoremap="true"/>
      <IfThenElse>
        <ScriptCondition code="skip_intro == true"/>
        <AskIntelligence skill="explanation.open_direct"/>
        <AskIntelligence skill="explanation.open"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ExplanationTurn">
    <Sequence>
      <AskIntelligence skill="explanation.check" user_text="{user_text}"/>
      <Switch6 variable="{label}" case_1="verified" case_2="progress" case_3="question"
               case_4="declines" case_5="gaps" case_6="not_understood">
        <Sequence>
          <AskIntelligence skill="explanation.confirmed"/>
          <Script code="done := true"/>
        </Sequence>
        <!-- Progress (new points right, none wrong): ask only for the critical points still
             missing; not a failed check -->
        <AskIntelligence skill="explanation.ask_missing"/>
        <AskIntelligence skill="explanation.answer" user_text="{user_text}"/>
        <!-- The fallback of teach-back: a direct question about the most critical point -->
        <AskIntelligence skill="explanation.targeted"/>
        <!-- Explain again only the points missing or wrong -->
        <SubTree ID="ExplanationRepair" _autoremap="true" how="points"/>
        <!-- Explain the whole topic again in another way -->
        <SubTree ID="ExplanationRepair" _autoremap="true" how="all"/>
        <!-- Other: the check again, or close after max_stalled turns without progress -->
        <IfThenElse>
          <SubTree ID="NoProgress" _autoremap="true"/>
          <AskIntelligence skill="explanation.ask_again"/>
          <SubTree ID="EndDialogue" _autoremap="true" reason="breakdown"/>
        </IfThenElse>
      </Switch6>
    </Sequence>
  </BehaviorTree>

  <!-- A failed check: explain again (how: points or all) and check again, or, after
       max_attempts failed checks, close reminding the critical points -->
  <BehaviorTree ID="ExplanationRepair">
    <Sequence>
      <Script code="attempts += 1"/>
      <IfThenElse>
        <ScriptCondition code="attempts &lt; max_attempts"/>
        <AskIntelligence skill="explanation.repair" option="{how}" number="{attempts}"/>
        <Sequence>
          <AskIntelligence skill="explanation.give_up" number="{attempts}"/>
          <Script code="done := true"/>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>
</root>
