<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by make_ablations.py (no_confirmation) from the method's slot_filling.xml -->
<root BTCPP_format="4" main_tree_to_execute="SlotFilling">
  <include path="common.xml"/>

  <!-- Collect structured data (the frame of slots), then read it back and confirm it.
       1. The frame comes from the request's schema, or the LLM designs it from the task; the
          request can pre-fill it (resume). The opening asks for the first missing slot, or
          resumes, or (frame already complete) asks for confirmation.
       2. Gathering: each turn is understood (the slots it gives or corrects, a question, a
          slot the user cannot or will not give) and applied to the frame; the robot
          acknowledges it and asks for what is missing. A slot asked max_attempts times is
          asked differently, and after one more failed attempt it is left unanswered. A turn
          not understood counts as a turn without progress.
       3. Confirming: the robot reads the frame back (saying which slots are left blank). The
          user confirms (success; partial if a slot is unanswered), asks a question
          (answered), corrects a value (applied: confirm again, or gather again if a slot
          became empty) or answers unclearly (a turn without progress: confirm again).
       After max_stalled turns in a row without progress the robot closes (breakdown).
       The result is the frame (data). -->
  <BehaviorTree ID="SlotFilling">
    <Sequence>
      <!-- The opening, with fillers while it is prepared (and its own time budget) -->
      <WithFillers budget_s="{opening_budget}">
        <SubTree ID="SlotFillingOpening" _autoremap="true"/>
      </WithFillers>
      <Speak text="{reply}"/>
      <Fallback>
        <!-- One user turn per cycle; the loop ends (fails) when the dialogue is done, at the
             turn limit, or on a failure of the system -->
        <Repeat num_cycles="-1">
          <Sequence>
            <SubTree ID="TurnLimit" _autoremap="true"/>
            <IfThenElse>
              <SubTree ID="ListenToUser" _autoremap="true"/>
              <Sequence>
                <!-- The reply to the turn, with fillers while it is prepared -->
                <WithFillers>
                  <Fallback>
                    <SubTree ID="CancelCheck" _autoremap="true"/>
                    <SubTree ID="SlotFillingTurn" _autoremap="true"/>
                  </Fallback>
                </WithFillers>
                <SubTree ID="CountProgress" _autoremap="true"/>
                <Speak text="{reply}"/>
              </Sequence>
              <SubTree ID="UserSilent" _autoremap="true"/>
            </IfThenElse>
            <ScriptCondition code="done == false"/>
          </Sequence>
        </Repeat>
        <SubTree ID="Conclude" _autoremap="true"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlotFillingOpening">
    <Sequence>
      <SubTree ID="Begin" _autoremap="true"/>
      <AskIntelligence skill="slot_filling.prepare"/>
      <Switch2 variable="{label}" case_1="complete" case_2="resumed">
        <AskIntelligence skill="slot_filling.confirmation_question" option="opening"/>
        <AskIntelligence skill="slot_filling.resume_opening"/>
        <IfThenElse>
          <ScriptCondition code="skip_intro == true"/>
          <AskIntelligence skill="slot_filling.opening_direct"/>
          <AskIntelligence skill="slot_filling.opening"/>
        </IfThenElse>
      </Switch2>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlotFillingTurn">
    <IfThenElse>
      <ScriptCondition code="phase == 'gathering'"/>
      <SubTree ID="SlotFillingGather" _autoremap="true"/>
      <SubTree ID="SlotFillingConfirm" _autoremap="true"/>
    </IfThenElse>
  </BehaviorTree>

  <BehaviorTree ID="SlotFillingGather">
    <Sequence>
      <AskIntelligence skill="slot_filling.update" user_text="{user_text}"
                       number="{max_attempts}"/>
      <Switch2 variable="{label}" case_1="complete" case_2="not_understood">
        <Sequence>
          <AskIntelligence skill="slot_filling.confirmed"/>
          <Script code="done := true"/>
        </Sequence>
        <!-- Not understood: ask again, or close after max_stalled turns without progress -->
        <IfThenElse>
          <SubTree ID="NoProgress" _autoremap="true"/>
          <AskIntelligence skill="slot_filling.next_question" user_text="{user_text}"
                           number="{max_attempts}"/>
          <SubTree ID="EndDialogue" _autoremap="true" reason="breakdown"/>
        </IfThenElse>
        <!-- Understood (values, a question, a slot left unanswered): ask for what is missing -->
        <AskIntelligence skill="slot_filling.next_question" user_text="{user_text}"
                         number="{max_attempts}"/>
      </Switch2>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlotFillingConfirm">
    <Sequence>
      <AskIntelligence skill="slot_filling.classify_confirmation" user_text="{user_text}"/>
      <Switch4 variable="{label}" case_1="confirms" case_2="question"
               case_3="corrects_reopened" case_4="corrects_applied">
        <Sequence>
          <AskIntelligence skill="slot_filling.confirmed"/>
          <Script code="done := true"/>
        </Sequence>
        <AskIntelligence skill="slot_filling.answer_question" user_text="{user_text}"/>
        <!-- A correction emptied a slot: gather it again -->
        <AskIntelligence skill="slot_filling.next_question" user_text="{user_text}"
                         number="{max_attempts}"/>
        <AskIntelligence skill="slot_filling.correction_reply"/>
        <!-- Unclear: ask for the confirmation again, or close after max_stalled turns without
             progress -->
        <IfThenElse>
          <SubTree ID="NoProgress" _autoremap="true"/>
          <AskIntelligence skill="slot_filling.confirmation_question"/>
          <SubTree ID="EndDialogue" _autoremap="true" reason="breakdown"/>
        </IfThenElse>
      </Switch4>
    </Sequence>
  </BehaviorTree>
</root>
