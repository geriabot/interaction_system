<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Monolithic">
  <include path="common.xml"/>

  <!-- Ablation: the LLM runs the whole strategy (the design of AutoTOD, Dobby and the
       monolithic baselines). After `begin` prepares the strategy as the method does (its
       resources, the form), the LLM gets the task, the strategy's rules, the material and the
       conversation, writes every reply and decides when the dialogue ends and its result.

       The rest is the method's (common.xml): the turn limit, listening, the silences, the
       conversational fillers while a reply is prepared, the closing lines of those endings and
       of a failure of the system, and the conclusion with its outcome. There is no spoken cancellation subtree and no count of turns without
       progress: the LLM is told to handle cancellation and misunderstandings itself. -->
  <BehaviorTree ID="Monolithic">
    <Sequence>
      <WithFillers budget_s="{opening_budget}">
        <Sequence>
          <SubTree ID="Begin" _autoremap="true"/>
          <AskIntelligence skill="monolithic.open"/>
        </Sequence>
      </WithFillers>
      <Speak text="{reply}"/>
      <Fallback>
        <Repeat num_cycles="-1">
          <Sequence>
            <SubTree ID="TurnLimit" _autoremap="true"/>
            <IfThenElse>
              <SubTree ID="ListenToUser" _autoremap="true"/>
              <Sequence>
                <WithFillers>
                  <AskIntelligence skill="monolithic.turn" user_text="{user_text}"/>
                </WithFillers>
                <Script code="done := label == 'done'"/>
                <Speak text="{reply}"/>
              </Sequence>
              <SubTree ID="UserSilent" _autoremap="true"/>
            </IfThenElse>
            <ScriptCondition code="done == false"/>
          </Sequence>
        </Repeat>
        <SubTree ID="Conclude" _autoremap="true"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
