# ROS 2 / colcon build artifacts
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Evaluation outputs (generated, not source)
evaluation/results/*.json
evaluation/results/*.csv

# Model binaries (download separately)
*.onnx
*.task

# Editor / OS noise
.vscode/
.idea/
*~
*.swp
.DS_Store

# Secrets (never commit API keys)
.env
*.key

# Environments (pixi/conda)
.pixi/

# The results and private notes of the evaluation (the runs write their results in
# evaluation/results; evaluation/private holds what stays out of the repository). evaluation/ and
# paper/ are submodules with their own ignore rules; these lines cover clones made before.
evaluation/results/
evaluation/offline/results/
evaluation/results_archive/
evaluation/private/
