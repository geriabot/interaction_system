# Goal
# Limits: leave them unset (USE_DEFAULT / USE_DEFAULT_SECONDS) to use the system's values (the
# parameters of the orchestrator); UNLIMITED (0) removes the limit.
int32   USE_DEFAULT = -1
float64 USE_DEFAULT_SECONDS = -1.0
int32   UNLIMITED = 0

string task_description    # Natural-language description of what the robot must accomplish.
                            # When dialog_mode is empty, the dialogue behavior is chosen
                            # from it: describe the phase the robot is in, e.g. "Gait speed
                            # test: explaining the walk to the participant".
string frame_schema_json   # Optional. JSON slot schema {"slots":[{name,type,...}]}.
                            # When non-empty, bypasses LLM frame generation entirely.
                            # Slot fields: name (str), type (str|int|float|bool|list_str),
                            # canonical_values ([str]), condition_slot (str),
                            # condition_value (str), and for int/float slots the numeric
                            # bounds minimum | exclusive_minimum, maximum |
                            # exclusive_maximum (number). A condition on an int/float
                            # parent may use a range instead of condition_value:
                            # condition_minimum, condition_exclusive_minimum,
                            # condition_maximum, condition_exclusive_maximum.
                            # See DialogFrame.from_slots_json().
string initial_frame_json  # Optional JSON object pre-filling slot values (resume support).
                            # Applied after frame creation, whether from schema or LLM.
string dialog_mode          # "slot_filling" | "explanation" | "quiz" | "procedure" |
                            # "roleplay" | "grounded_qa" | "questionnaire". Empty: the system
                            # chooses the behavior the task description needs, over the
                            # whole catalog, or none. Named or chosen, the request must carry
                            # that behavior's material (explanation: a reference text or key
                            # points; quiz: a question bank; procedure: the steps; roleplay:
                            # the scene; grounded_qa: a plain-text material; questionnaire: an
                            # instrument; slot_filling: none). Otherwise the request ends
                            # before any conversation with outcome not_feasible.
string resources_json       # JSON array of {name, description, content} objects.
                            # For quiz mode, the first parseable resource must be a JSON
                            # list of {"question","answer"} objects.
                            # For procedure mode, the first parseable resource must be a
                            # JSON list of steps: strings or {"step","check","duration_s",
                            # "optional"} objects (duration_s: the seconds the step takes, during
                            # which the robot waits silently; optional: skipping it does not make
                            # the outcome partial).
                            # For roleplay mode, the first parseable resource must be a
                            # JSON object {"scenario","role","criteria":[...]} with
                            # optional "user_goal" and "max_exchanges".
                            # For explanation, the content to explain: a resource whose
                            # content is {"key_points": [...]} (strings, or
                            # {"point","critical"}), and/or plain-text resources (the
                            # reference text the key points are listed from when not given).
                            # For grounded_qa, the plain-text resources are the material the
                            # robot answers from; a resource named "handover" holds the
                            # sentence that offers a person when the answer is not there.
                            # For questionnaire, a JSON object {"name","instructions",
                            # "options","items","scoring"} (items: strings or {"text",
                            # "reverse","clarification","options"}).
string domain               # Free-text hint injected into every prompt as context
                            # (e.g. "hospital", "coffee shop", "university helpdesk").
                            # Helps the LLM use domain-appropriate tone and vocabulary.
bool   skip_intro           # If true, skip the opening greeting and go directly to the
                            # first question / explanation content. Use when chaining
                            # dialogs so the robot does not re-greet the user each time.
int32   max_turns -1        # Most user turns. -1 (USE_DEFAULT): the system's value; 0: unlimited.
float64 max_silence -1.0    # Seconds of continuous silence of the user after which the robot
                            # closes the dialogue (outcome user_silent). -1.0
                            # (USE_DEFAULT_SECONDS): the system's value; 0: never.
int32   max_stalled -1      # User turns in a row without progress (not understood, asked to
                            # repeat) after which the robot closes the dialogue (outcome
                            # breakdown). -1 (USE_DEFAULT): the system's value; 0: unlimited.
int32   max_attempts -1     # Attempts per element (explanations of a topic, helps with a step,
                            # askings of a slot, repetitions of a quiz question) before the
                            # strategy moves on or closes. -1 (USE_DEFAULT): the system's value.
int32   max_off_task -1     # Requests in a row outside the task (grounded question answering;
                            # a question within the task resets the count) after which the robot
                            # closes the dialogue (outcome breakdown, reason "Off-task: ...").
                            # -1 (USE_DEFAULT): the system's value; 0: unlimited.
float64 filler_after_s -1.0 # Seconds the robot may take to answer before it says a fixed
                            # ladder of conversational fillers ("Hmm..." and, as the wait grows,
                            # "One moment...", "Let me think about it for a moment...", "Almost
                            # there..."; not turns of the dialogue). -1.0 (USE_DEFAULT_SECONDS):
                            # the system's value; 0: no fillers.
float64 filler_repeat_s -1.0 # After the ladder, seconds between fillers ("Still on it...").
                            # -1.0 (USE_DEFAULT_SECONDS): the system's value.
float64 wait_timeout -1.0   # Seconds of silence of the user before each prompt that the robot is
                            # waiting ("Take your time"). -1.0 (USE_DEFAULT_SECONDS) or 0: the
                            # system's value.
float64 reply_budget -1.0   # Seconds the intelligence may spend asking the model for one reply
                            # before it answers with the skills' fallbacks. -1.0
                            # (USE_DEFAULT_SECONDS): the system's value; 0: no budget.
float64 opening_budget -1.0 # The same for the opening line. -1.0 (USE_DEFAULT_SECONDS): the
                            # system's value; 0: no budget.
int32   acknowledgments -1  # Whether the robot prefixes its replies with a short acknowledgment
                            # ("Noted.", "Got it."). -1 (USE_DEFAULT): the system's value; 0: no;
                            # 1: yes.
int32   reasoning -1        # Whether the model may reason before the critical understanding
                            # questions (selective reasoning: more reliable, slower turns there).
                            # -1 (USE_DEFAULT): the system's value (the intelligence's
                            # `reasoning`); 0: no reasoning at all; 1: on the critical questions.
---
# Result
# How the dialogue ended. Only OUTCOME_COMPLETED is a success; failure_reason says why otherwise.
string OUTCOME_COMPLETED = "completed"     # The task was done: every element completed
string OUTCOME_PARTIAL = "partial"         # Ended normally, some element left unfinished (an
                                           # unanswered slot or question, a skipped or stuck step)
string OUTCOME_FAILED = "failed"           # The goal of the strategy was not achieved (e.g. the
                                           # explanation was not understood)
string OUTCOME_CANCELLED = "cancelled"     # The user asked to stop, or the goal was cancelled
string OUTCOME_USER_SILENT = "user_silent" # The user stayed silent max_silence seconds
string OUTCOME_BREAKDOWN = "breakdown"     # max_stalled user turns in a row without progress
string OUTCOME_TURN_LIMIT = "turn_limit"   # max_turns reached
string OUTCOME_ERROR = "error"             # A failure of the system (the LLM, speech, the request)
string OUTCOME_NOT_FEASIBLE = "not_feasible" # Refused before any conversation (total_turns 0):
                                           # no dialogue behavior fits the task, or the request
                                           # lacks the material of the behavior it needs
bool   success
string outcome
string final_frame_json
string failure_reason
int32  total_turns
---
# Feedback
string state
string current_frame_json
string last_utterance
int32  turns