<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>interaction_system_behaviors</name>
  <version>0.1.0</version>
  <description>The dialogue behaviors of the interaction system: one Behavior Tree per dialogue strategy (XML), and the BehaviorTree.CPP nodes they use (speak and listen through the speech capability, ask the interaction intelligence).</description>
  <maintainer email="rodrigo.perez@urjc.es">Rodrigo Pérez-Rodríguez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp</depend>
  <depend>std_msgs</depend>
  <depend>ros2_dialog_interfaces</depend>
  <depend>simple_hri_interfaces</depend>
  <depend>interaction_system_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
